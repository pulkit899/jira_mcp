# --- Jira ---
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_DEPLOYMENT=cloud            # cloud | server  (server = Server/Data Center)
JIRA_EMAIL=you@company.com       # Cloud only
JIRA_API_TOKEN=                  # Cloud: id.atlassian.com/manage-profile/security/api-tokens
                                 # Server/DC: a Personal Access Token
JIRA_DEFAULT_PROJECT=AEP         # optional, used when create_issue has no project_key
JIRA_READ_ONLY=false             # true = disable create/update/comment/transition

# --- MCP server ---
MCP_API_KEY=                     # long random string; Coworker sends it as X-Api-Key
HOST=0.0.0.0
PORT=8000
